# ── Copier ce fichier en .env et adapter les valeurs ──
# (le fichier .env est ignoré par git — ne jamais y committer de secrets)

# ── Mode ──
# Développement local : True | Production : False (défaut sûr)
DJANGO_DEBUG=True

# ── Sécurité (OBLIGATOIRE en production) ──
# Générer avec : openssl rand -hex 50  (ou équivalent PowerShell)
DJANGO_SECRET_KEY=
# Hôtes autorisés, séparés par des virgules (ex: erp.chu.example)
DJANGO_ALLOWED_HOSTS=*
# Origines CSRF de confiance si HTTPS (ex: https://erp.chu.example)
CSRF_TRUSTED_ORIGINS=

# ── Base de données (PostgreSQL en production) ──
# Alternative : définir DATABASE_URL à la place
# DATABASE_URL=postgres://user:pass@host:5432/chu_angre_db
DB_NAME=chu_angre_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Notifications e-mail (SMTP) ──
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ── Notifications SMS (Twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Alertes de supervision (commande verifier_sante) ──
# Destinataires des alertes en cas de panne (séparés par des virgules)
ALERT_EMAILS=
ALERT_PHONES=
